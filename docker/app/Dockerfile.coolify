FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN npm run build

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist --optimize-autoloader --ignore-platform-req=ext-intl

FROM php:8.4-fpm-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libicu-dev libzip-dev libpng-dev libjpeg62-turbo-dev libwebp-dev sqlite3 libsqlite3-dev curl \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j2 intl pdo_sqlite zip gd opcache \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --from=vendor --chown=www-data:www-data /app/vendor ./vendor
COPY --from=frontend --chown=www-data:www-data /app/public/build ./public/build
COPY docker/app/php.ini /usr/local/etc/php/conf.d/simple-view.ini
COPY docker/app/entrypoint.sh /usr/local/bin/simple-view-entrypoint
RUN rm -f bootstrap/cache/*.php \
    && php artisan package:discover --ansi \
    && chmod +x /usr/local/bin/simple-view-entrypoint
USER www-data
ENTRYPOINT ["simple-view-entrypoint"]
CMD ["php-fpm"]
